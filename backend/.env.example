# Database (MySQL) — usado apenas pelo PHP Bridge no servidor
DB_HOST=srv36.prodns.com.br
DB_PORT=3306
DB_NAME=bci_formulario
DB_USER=
DB_PASSWORD=

# FTP — acesso aos arquivos de upload
FTP_HOST=srv36.prodns.com.br
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_BASE_PATH=/public_html/uploads

# PHP Bridge — proxy para MySQL (bypasses firewall)
PHP_BRIDGE_URL=https://bciventures.com.br/api_bridge.php

# CORS — origens permitidas
CORS_ORIGINS=["http://localhost:5173","https://bciventures.com.br"]

# App
DEBUG=true
